#!/usr/bin/ucode
// SPDX-License-Identifier: Apache-2.0
//
// prism-router-metrics —— Prometheus 指标导出（CGI）
// 安装为 /www/cgi-bin/prism-router-metrics，契约见 docs/SPEC.md §10.3。
//
// ───────────────────────── 安全边界（必读，别按直觉改）─────────────────────────
//   * 只读：只 readfile /tmp/prism-router/state.json 与 /etc/prism-router/devices.json，
//     **不写任何文件、不 fork 任何子进程**（一次抓取只有两次读）。
//   * 认证：UCI settings.metrics_enabled 必须为 1，**且** metrics_token 非空；
//     请求需带 ?token=<token> 或 Authorization: Bearer <token>。
//     未启用 / 未配 token / token 不对 —— 一律 403，不区分原因（不给探测者信息）。
//     比对是常量时间的，不把比较耗时变成可观测信号。
//   * 这是**仅限局域网**的明文接口：token 走 URL 查询串时可能进 web 服务器访问日志，
//     也不能防窃听/重放。要跨不可信网络，换传输层（TLS / WireGuard / Tailscale），
//     不要在这条通道上自创"弱签名"。
//   * 数据缺失 / JSON 坏掉：仍然 200，只是没有对应样本（traffic_state_present=0）。
//     Prometheus 会保留历史样本，不会因为一次抓取失败把曲线清空。
//
// ───────────────────────── 指标 ─────────────────────────
//   traffic_info{version="1.0.0"} 1
//   traffic_up 1|0                                  state.json 是否新鲜（守护进程活着）
//   traffic_state_present 0|1
//   traffic_state_ts_seconds N
//   traffic_state_age_seconds N
//   traffic_devices_online N                        last_seen 在 300 秒内的设备数
//   traffic_rx_rate_bytes_per_second N
//   traffic_tx_rate_bytes_per_second N
//   traffic_proxy_rx_bytes_total N                  ⚠ 进程启动以来累计（重启归零）
//   traffic_proxy_tx_bytes_total N
//   traffic_direct_rx_bytes_total N
//   traffic_direct_tx_bytes_total N
//   traffic_device_rx_bytes{mac,hostname,alias,group} N
//   traffic_device_tx_bytes{mac,hostname,alias,group} N
//   traffic_system_*                                state.json 的 system 段，**存在才输出**
//
// 所有数值都是定点整数 / 1 位小数，不会出现科学计数法。
// 标签值按 Prometheus 文本格式转义（\ -> \\，" -> \"，换行 -> \n）。
//
// 手工调试（不需要 web 服务器，直接喂环境变量）：
//   env REQUEST_METHOD=GET QUERY_STRING="token=abc" ucode /www/cgi-bin/prism-router-metrics
//
// 依赖：ucode（fs/uci 内建）。不需要 curl / openssl。
'use strict';

import { readfile, writefile } from 'fs';
import { cursor } from 'uci';

/* 测试钩子（生产环境不要设置）：把读取路径换成 fixture，便于容器门禁离线验证。 */
function env_or(name, fallback) {
	const value = getenv(name);

	if (value == null || length(value) == 0)
		return fallback;

	return value;
}

const UCI_CONFIG   = 'prism-router';
const VERSION      = '1.0.22';
const STATE_FILE   = env_or('PRISM_ROUTER_STATE_FILE', '/tmp/prism-router/state.json');
const DEVICES_FILE = env_or('PRISM_ROUTER_DEVICES_FILE', '/etc/prism-router/devices.json');

const TMP_DIR      = '/tmp/prism-router';
const LOG_STATE    = `${TMP_DIR}/metrics-lastlog`;
const LOG_GAP      = 60;      /* 认证失败日志节流（秒） */
const MAX_DEVICES  = 200;     /* 与 state.json 的 devices 上限一致 */
const ONLINE_SECS  = 300;     /* last_seen 在 5 分钟内算在线 */
const META_TEXT_MAX = 128;    /* 标签值字节上限，防脏 devices.json 撑爆响应 */

/* system 段透传表：[ state.json 字段, Prometheus 指标名, 是否小数 ] */
const SYSTEM_METRICS = [
	[ 'cpu_pct',          'traffic_system_cpu_pct',              true  ],
	[ 'cpu_cores',        'traffic_system_cpu_cores',            false ],
	[ 'load1',            'traffic_system_load1',                true  ],
	[ 'load5',            'traffic_system_load5',                true  ],
	[ 'load15',           'traffic_system_load15',               true  ],
	[ 'mem_total',        'traffic_system_mem_total_bytes',      false ],
	[ 'mem_avail',        'traffic_system_mem_avail_bytes',      false ],
	[ 'mem_pct',          'traffic_system_mem_pct',              true  ],
	[ 'swap_total',       'traffic_system_swap_total_bytes',     false ],
	[ 'swap_free',        'traffic_system_swap_free_bytes',      false ],
	[ 'temp_c',           'traffic_system_temp_celsius',         true  ],
	[ 'disk_total',       'traffic_system_disk_total_bytes',     false ],
	[ 'disk_used',        'traffic_system_disk_used_bytes',      false ],
	[ 'disk_pct',         'traffic_system_disk_pct',             true  ],
	[ 'uptime',           'traffic_system_uptime_seconds',       false ],
	[ 'wan_rx_rate',      'traffic_system_wan_rx_bytes_per_second', false ],
	[ 'wan_tx_rate',      'traffic_system_wan_tx_bytes_per_second', false ]
];

// ───────────────────────────── 基础工具 ─────────────────────────────

function text(value, fallback) {
	return (value == null) ? fallback : `${value}`;
}

function integer(value, fallback) {
	if (value == null)
		return fallback;

	const n = int(value);

	return (n != n) ? fallback : n;
}

function clamp(n, lo, hi) {
	return (n < lo) ? lo : ((n > hi) ? hi : n);
}

function num(value) {
	const t = type(value);

	if (t == 'int' || t == 'double')
		return value;

	return null;
}

/* 按字节截断且不切断 UTF-8 码点（length() 是字节长度）。 */
function cut_text(s, maxb) {
	let v = `${s}`;

	if (length(v) <= maxb)
		return v;

	let n = maxb;

	while (n > 0 && (ord(substr(v, n, 1)) & 0xc0) == 0x80)
		n--;

	return substr(v, 0, n);
}

function read_json(path) {
	let raw = null;

	try {
		raw = readfile(path);
	}
	catch (e) {
		return null;
	}

	if (type(raw) != 'string' || length(raw) == 0)
		return null;

	try {
		const parsed = json(raw);

		return (type(parsed) == 'object') ? parsed : null;
	}
	catch (e) {
		return null;
	}
}

function uci_get(section, option, fallback) {
	let c = null;

	try {
		c = cursor();
	}
	catch (e) {
		return fallback;
	}

	if (c == null)
		return fallback;

	const value = c.get(UCI_CONFIG, section, option);

	return (value == null) ? fallback : value;
}

function flag(section, option) {
	return int(trim(text(uci_get(section, option, '0'), '0'))) != 0;
}

function note(msg) {
	const now = time();
	let last = 0;

	try {
		last = integer(trim(text(readfile(LOG_STATE), '')), 0);
	}
	catch (e) {
		last = 0;
	}

	if (last > 0 && now - last < LOG_GAP)
		return;

	try {
		writefile(LOG_STATE, sprintf('%d\n', now));
	}
	catch (e) {
		/* 记不上就算了，别因为日志失败影响响应 */
	}

	system([ 'logger', '-t', 'prism-router-metrics', '-p', 'daemon.warn', cut_text(msg, 200) ]);
}

// ───────────────────────────── 查询串 / 认证 ─────────────────────────────

function hexval(c) {
	return index('0123456789abcdef', lc(c));
}

function url_decode(s) {
	let out = '';

	for (let i = 0; i < length(s); i++) {
		const c = substr(s, i, 1);

		if (c == '+') {
			out += ' ';
			continue;
		}

		if (c == '%' && i + 2 < length(s)) {
			const h = lc(substr(s, i + 1, 2));
			const hi = hexval(substr(h, 0, 1));
			const lo = hexval(substr(h, 1, 1));

			if (hi >= 0 && lo >= 0) {
				out += chr(hi * 16 + lo);
				i += 2;
				continue;
			}
		}

		out += c;
	}

	return out;
}

function query_params() {
	const out = {};
	const qs = trim(text(getenv('QUERY_STRING'), ''));

	if (length(qs) == 0)
		return out;

	for (let pair in split(qs, '&')) {
		if (length(pair) == 0)
			continue;

		const eq = index(pair, '=');

		if (eq < 0) {
			out[url_decode(pair)] = '';
			continue;
		}

		out[url_decode(substr(pair, 0, eq))] = url_decode(substr(pair, eq + 1));
	}

	return out;
}

/* 请求里的 token：优先 ?token=，其次 Authorization: Bearer <token>。 */
function request_token() {
	const query = query_params();
	const direct = trim(text(query.token, ''));

	if (length(direct) > 0)
		return direct;

	let auth = getenv('HTTP_AUTHORIZATION');

	if (auth == null || length(trim(auth)) == 0)
		auth = getenv('AUTHORIZATION');

	const m = match(trim(text(auth, '')), /^[Bb]earer[ \t]+(.+)$/);

	if (m != null)
		return trim(m[1]);

	return '';
}

/* 常量时间比较（长度不同直接失败）。 */
function same_text(a, b) {
	if (length(a) != length(b))
		return false;

	let diff = 0;

	for (let i = 0; i < length(a); i++)
		diff |= ord(substr(a, i, 1)) ^ ord(substr(b, i, 1));

	return diff == 0;
}

// ───────────────────────────── 输出 ─────────────────────────────

/* Prometheus 文本格式的标签转义：\ -> \\，" -> \"，换行 -> \n。
   其它控制字符按空格处理（文本格式没定义它们，留原样会让抓取端解析失败）。 */
function esc_label(value) {
	const src = cut_text(text(value, ''), META_TEXT_MAX);
	let out = '';

	for (let i = 0; i < length(src); i++) {
		const c = substr(src, i, 1);
		const n = ord(c);

		if (c == '\\')
			out += '\\\\';
		else if (c == '"')
			out += '\\"';
		else if (n == 10)
			out += '\\n';
		else if (n < 0x20 || n == 0x7f)
			out += ' ';
		else
			out += c;
	}

	return out;
}

let body = '';

function heading(name, kind, help) {
	body += `# HELP ${name} ${help}\n# TYPE ${name} ${kind}\n`;
}

function sample(name, labels, value) {
	body += `${name}${labels} ${value}\n`;
}

function device_labels(dev, meta) {
	const mac = lc(trim(text(dev?.mac, '')));
	const info = (length(mac) > 0) ? (meta[mac] ?? null) : null;

	return `{mac="${esc_label(mac)}",hostname="${esc_label(dev?.hostname)}"`
		+ `,alias="${esc_label(info?.alias)}",group="${esc_label(info?.group)}"}`;
}

/* 数值 -> 定点字符串；非法/越界返回 null（不输出该样本）。 */
function fixed(value, decimal) {
	const n = num(value);

	if (n == null || n != n)
		return null;

	if (decimal)
		return sprintf('%.1f', n);

	return sprintf('%d', int(n));
}

// ───────────────────────────── 响应 ─────────────────────────────

function respond(status, reason, contentType, payload, method) {
	if (status != 200)
		print(sprintf('Status: %d %s\r\n', status, reason));

	print(`Content-Type: ${contentType}\r\n`);
	print('Cache-Control: no-store\r\n');
	print('X-Content-Type-Options: nosniff\r\n');
	print('\r\n');

	if (method != 'HEAD')
		print(payload);
}

function forbidden() {
	respond(403, 'Forbidden', 'text/plain; charset=utf-8', '403 forbidden\n',
		trim(text(getenv('REQUEST_METHOD'), 'GET')));
}

/* 读 devices.json（别名/分组）：只收 MAC 键，坏文件退化成空表。 */
function read_meta() {
	const out = {};
	const raw = read_json(DEVICES_FILE);

	if (raw == null || type(raw) != 'object')
		return out;

	for (let key, value in raw) {
		const mac = lc(replace(trim(text(key, '')), '-', ':'));

		if (length(mac) != 17 || type(value) != 'object')
			continue;

		const entry = {};

		if (value.alias != null)
			entry.alias = cut_text(text(value.alias, ''), META_TEXT_MAX);

		if (value.group != null)
			entry.group = cut_text(text(value.group, ''), META_TEXT_MAX);

		out[mac] = entry;
	}

	return out;
}

// ───────────────────────────── 主流程 ─────────────────────────────

function main() {
	const method = trim(text(getenv('REQUEST_METHOD'), 'GET'));

	/* 认证先于一切：未启用 / 未配 token / token 不对都是 403，不给任何细节。 */
	const expected = trim(text(uci_get('settings', 'metrics_token', ''), ''));

	if (!flag('settings', 'metrics_enabled') || length(expected) == 0) {
		note('metrics 请求被拒：未启用或未配置 metrics_token');
		forbidden();
		return 0;
	}

	const token = request_token();

	if (length(token) == 0 || !same_text(token, expected)) {
		note('metrics 请求被拒：token 缺失或不匹配');
		forbidden();
		return 0;
	}

	if (method != 'GET' && method != 'HEAD') {
		respond(405, 'Method Not Allowed', 'text/plain; charset=utf-8', '405 method not allowed\n', method);
		return 0;
	}

	const now = time();
	const poll = clamp(integer(uci_get('settings', 'poll_interval', 5), 5), 1, 3600);
	const state = read_json(STATE_FILE);
	const meta = read_meta();

	heading('traffic_info', 'gauge', 'prism-router exporter metadata');
	sample('traffic_info', `{version="${esc_label(VERSION)}"}`, '1');

	const present = (state != null) ? 1 : 0;
	const ts = integer(state?.ts, 0);
	const age = (ts > 0) ? max(0, now - ts) : -1;
	const up = (present && ts > 0 && (now - ts) <= max(30, poll * 6)) ? 1 : 0;

	heading('traffic_up', 'gauge', '1 if prism-routerd is freshly writing state.json');
	sample('traffic_up', '', `${up}`);

	heading('traffic_state_present', 'gauge', '1 if state.json was readable');
	sample('traffic_state_present', '', `${present}`);

	if (ts > 0) {
		heading('traffic_state_ts_seconds', 'gauge', 'state.json timestamp (unix seconds)');
		sample('traffic_state_ts_seconds', '', `${ts}`);
	}

	if (age >= 0) {
		heading('traffic_state_age_seconds', 'gauge', 'age of state.json in seconds');
		sample('traffic_state_age_seconds', '', `${age}`);
	}

	if (state == null) {
		/* 没有 state：只给 up/info，device/totals/system 一律不输出（不猜 0）。 */
		respond(200, 'OK', 'text/plain; version=0.0.4; charset=utf-8', body, method);
		return 0;
	}

	const totals = (type(state.totals) == 'object') ? state.totals : {};
	const devices = (type(state.devices) == 'array') ? state.devices : [];

	const rate_rx = fixed(totals.rx_rate, false);
	const rate_tx = fixed(totals.tx_rate, false);

	if (rate_rx != null) {
		heading('traffic_rx_rate_bytes_per_second', 'gauge', 'current total rx rate');
		sample('traffic_rx_rate_bytes_per_second', '', rate_rx);
	}

	if (rate_tx != null) {
		heading('traffic_tx_rate_bytes_per_second', 'gauge', 'current total tx rate');
		sample('traffic_tx_rate_bytes_per_second', '', rate_tx);
	}

	const COUNTERS = [
		[ 'proxy_rx',  'traffic_proxy_rx_bytes_total'  ],
		[ 'proxy_tx',  'traffic_proxy_tx_bytes_total'  ],
		[ 'direct_rx', 'traffic_direct_rx_bytes_total' ],
		[ 'direct_tx', 'traffic_direct_tx_bytes_total' ]
	];

	for (let item in COUNTERS) {
		const value = fixed(totals[item[0]], false);

		if (value == null)
			continue;

		heading(item[1], 'counter', `cumulative ${replace(item[0], '_', ' ')} since daemon start`);
		sample(item[1], '', value);
	}

	let online = 0;
	let rows = [];

	for (let i = 0; i < length(devices) && i < MAX_DEVICES; i++) {
		const dev = devices[i];

		if (type(dev) != 'object')
			continue;

		const last = integer(dev.last_seen, 0);

		if (last > 0 && now - last <= ONLINE_SECS)
			online++;

		const rx = integer(dev.direct_rx, 0) + integer(dev.proxy_rx, 0);
		const tx = integer(dev.direct_tx, 0) + integer(dev.proxy_tx, 0);

		push(rows, { dev: dev, rx: max(0, rx), tx: max(0, tx) });
	}

	rows = sort(rows, (a, b) => (b.rx + b.tx) - (a.rx + a.tx));

	heading('traffic_devices_online', 'gauge', 'devices seen in the last 300 seconds');
	sample('traffic_devices_online', '', `${online}`);

	heading('traffic_device_rx_bytes', 'gauge', 'per-device received bytes (daemon lifetime)');
	heading('traffic_device_tx_bytes', 'gauge', 'per-device transmitted bytes (daemon lifetime)');

	for (let row in rows) {
		const labels = device_labels(row.dev, meta);

		sample('traffic_device_rx_bytes', labels, `${row.rx}`);
		sample('traffic_device_tx_bytes', labels, `${row.tx}`);
	}

	const sys = (type(state.system) == 'object') ? state.system : {};

	for (let item in SYSTEM_METRICS) {
		const value = fixed(sys[item[0]], item[2]);

		if (value == null)
			continue;

		heading(item[1], 'gauge', replace(item[0], '_', ' '));
		sample(item[1], '', value);
	}

	respond(200, 'OK', 'text/plain; version=0.0.4; charset=utf-8', body, method);

	return 0;
}


exit(main());
