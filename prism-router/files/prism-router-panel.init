#!/bin/sh /etc/rc.common
# prism-router-panel —— 独立流量面板 HTTP 服务（procd 管理的 uhttpd 单实例）
#
# 与 LuCI 完全解耦：浏览器直接访问 http://<路由器 LAN 地址>:8099/ 就能打开只读面板，
# 不需要 LuCI 会话、不经过 LuCI 路由、也不碰 LuCI 的 uhttpd 实例。
#
# 默认**关闭**。开启方式（见 docs/SPEC.md「独立面板服务」）：
#
#   uci set prism-router.panel.enabled='1'
#   uci set prism-router.panel.port='8099'          # 1–65535，非法值回退 8099
#   uci set prism-router.panel.bind=''             # 留空 = 自动取 network.lan.ipaddr；都没有 = 监听所有接口
#   uci set prism-router.panel.token='<随机串>'     # 可留空（仅依赖网络边界）
#   uci commit prism-router
#   /etc/init.d/prism-router-panel enable
#   /etc/init.d/prism-router-panel restart
#
# 安装内容（见 ../Makefile）：
#   /etc/init.d/prism-router-panel            <- 本文件
#   /www/prism-router-panel/                  <- files/panel/*（index.html / app.js / style.css）
#   /www/prism-router-panel/cgi-bin/panel-api <- files/panel-api.uc（只读 ucode CGI）
#
# 安全边界：
#   * 只读：文档根只放静态页面，CGI 只调用 ubus 的 prism-router 只读方法；
#   * token 只从 UCI 读，**绝不写进日志**（本文件根本不读取 token）；
#   * bind 只接受 IPv4 字面量，其它值一律回退为"监听所有接口"，绝不把 UCI 原文拼进 argv；
#   * 默认关闭，且不会被 postinst 强制启动。

START=95
STOP=10
USE_PROCD=1

PANEL_HTTPD=/usr/sbin/uhttpd
PANEL_ROOT=/www/prism-router-panel
PANEL_CGI_PREFIX=/cgi-bin
DEFAULT_PORT=8099

# 端口归一：只接受 1–65535 的十进制数字，其它（空 / 非数字 / 越界）回退 8099。
panel_port() {
	local port="$1"

	case "$port" in
		''|*[!0-9]*) printf '%s\n' "$DEFAULT_PORT"; return 0 ;;
	esac

	# 前导 0 归一，避免 ash 把 08099 当八进制；"0" 归一后为空，同样回退。
	while [ "${port#0}" != "$port" ] && [ -n "${port#0}" ]; do
		port="${port#0}"
	done

	[ "${#port}" -le 5 ] || { printf '%s\n' "$DEFAULT_PORT"; return 0; }
	[ "$port" -ge 1 ] && [ "$port" -le 65535 ] \
		|| { printf '%s\n' "$DEFAULT_PORT"; return 0; }

	printf '%s\n' "$port"
}

# bind 只接受 IPv4 字面量（四段十进制，每段 0–255）。
# 不接受主机名 / IPv6 / 带端口的写法：这些值会被当作非法并回退"监听所有接口"。
panel_valid_ipv4() {
	local ip="$1" octet old_ifs

	case "$ip" in
		''|*[!0-9.]*) return 1 ;;
	esac

	old_ifs="$IFS"
	IFS='.'
	set -- $ip
	IFS="$old_ifs"

	[ $# -eq 4 ] || return 1

	for octet in "$@"; do
		[ -n "$octet" ] || return 1
		[ "${#octet}" -le 3 ] || return 1
		case "$octet" in
			''|*[!0-9]*) return 1 ;;
		esac
		[ "$octet" -ge 0 ] && [ "$octet" -le 255 ] || return 1
	done

	return 0
}

# uhttpd 的 -p 语法：有 bind 时 "addr:port"，否则只给 "port"（= 所有接口）。
panel_listen() {
	local bind="$1" port="$2"

	if [ -z "$bind" ]; then
		printf '%s\n' "$port"
	else
		printf '%s:%s\n' "$bind" "$port"
	fi
}

start_service() {
	local enabled=1
	local port bind listen

	config_load prism-router
	config_get_bool enabled panel enabled 0

	if [ "$enabled" -ne 1 ]; then
		# 默认关闭：不启动、不监听。打开方式见本文件头。
		logger -t prism-router-panel "disabled (prism-router.panel.enabled=0), not starting"
		return 0
	fi

	config_get port panel port "$DEFAULT_PORT"
	port="$(panel_port "$port")"

	# bind 优先级：panel.bind 显式配置 > network.lan.ipaddr > 所有接口
	config_get bind panel bind ''
	if [ -z "$bind" ]; then
		bind="$(uci -q get network.lan.ipaddr 2>/dev/null)"
	fi

	if [ -z "$bind" ] || [ "$bind" = "0.0.0.0" ]; then
		bind=''
		logger -t prism-router-panel "listening on all interfaces (0.0.0.0) port ${port}"
	elif ! panel_valid_ipv4 "$bind"; then
		bind=''
		logger -t prism-router-panel "invalid panel.bind (not an IPv4 literal), listening on all interfaces port ${port}"
	else
		logger -t prism-router-panel "listening on ${bind}:${port}"
	fi

	listen="$(panel_listen "$bind" "$port")"

	# uhttpd 由 prism-router 的 Depends 保证；缺失时明确失败，不要静默空转。
	if [ ! -x "$PANEL_HTTPD" ]; then
		logger -t prism-router-panel "missing $PANEL_HTTPD, not starting"
		return 1
	fi

	procd_open_instance "main"
	procd_set_param command "$PANEL_HTTPD" -f -h "$PANEL_ROOT" -x "$PANEL_CGI_PREFIX" -p "$listen" -t 60 -T 60 -A 1
	# 异常退出自动拉起：<阈值秒> <重启间隔> <次数，0=不限>
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# 端口 / bind 改完必须整体重启 uhttpd 才生效；token 由 CGI 每个请求重新读 UCI，不必重启。
reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "prism-router"
}