{
	"luci-app-traffic-stats": {
		"description": "流量统计 —— 只读面板（不包含配置密钥）",
		"read": {
			"ubus": {
				"traffic-stats": [ "status", "get_state", "get_history", "get_daily", "get_nodes", "get_stations", "export_csv" ]
			}
		}
	},
	"luci-app-traffic-stats-admin": {
		"description": "流量统计 —— 管理配置（可读写节点与推送密钥）",
		"read": {
			"ubus": {
				"traffic-stats": [ "status", "get_state", "get_history", "get_daily", "get_nodes", "get_stations", "export_csv" ]
			},
			"uci": [ "traffic-stats" ],
			"file": {
				"/etc/config/traffic-stats": [ "read" ]
			}
		},
		"write": {
			"ubus": {
				"traffic-stats": [ "test_feishu", "feishu_chats", "set_config", "restart", "set_device_meta" ]
			},
			"uci": [ "traffic-stats" ],
			"file": {
				"/etc/config/traffic-stats": [ "write" ]
			}
		}
	}
}
