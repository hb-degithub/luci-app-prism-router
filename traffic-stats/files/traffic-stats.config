# traffic-stats 默认配置（UCI）
# 字段名与默认值以 docs/SPEC.md §2 为准。

config settings 'settings'
	option enabled '1'
	# 轮询间隔（秒）
	option poll_interval '5'
	# OpenClash / mihomo 控制器地址
	option clash_api '127.0.0.1:9090'
	# 控制器密码；留空则自动读 openclash.config.dashboard_password
	option clash_secret ''
	# fake-ip 网段：conntrack 里 orig dst 落在这些段的流交给 clash 统计，避免双计
	option fake_ip_ranges '198.18.0.0/16'
	# LAN 网段；留空则自动从 firewall lan zone / 接口地址推断
	option lan_ranges ''
	# history / daily 保留天数
	option history_days '7'
	# ── 接入方式（无线 / 有线）判定：完全靠主路由自己的能力，AP 上不装任何东西 ──
	# 主路由 x86 多网卡桥接，哑桥 AP 挂在其中一个桥端口上；无线客户端与 AP 自己的
	# br-lan MAC 都学在同一个桥端口。守护进程用 `brctl showmacs <lan_bridge>` 读 FDB
	# （这台机器没有 bridge 命令，只有 /usr/sbin/brctl）。
	# 目标网桥
	option lan_bridge 'br-lan'
	# 无线上联的桥端口号，逗号分隔，例如 3 或 3,5（实测该 AP 是 3）。
	# 留空 = 不指定；此时若 ap_macs 也为空，FDB 里学到的设备会按 wired 归类。
	option wireless_ports ''
	# AP 的 LAN MAC（逗号分隔）。配上它则由守护进程用 FDB 反查端口，优先于 wireless_ports；
	# 实测该 AP 的 br-lan MAC 是 00:58:28:d7:63:60。
	option ap_macs ''
	# 重新读取 FDB 的间隔（秒）
	option link_refresh '30'
	# ── 软路由自身性能指标（state.json 的 system 段，SPEC §3.3）──────
	# 1 = 采集（默认）；0 = 整段不写入 state.json（老消费方完全无感）
	option system_enabled '1'
	# WAN 接口名（如 eth3 / pppoe-wan），用于 system.wan_rx_rate / wan_tx_rate；
	# 留空 = 自动取 /proc/net/route 里默认路由（metric 最小）所在接口
	option wan_iface ''
	# ── 子母多节点汇总 ────────────────────────────────────────────────
	# 本机节点 ID（母节点用它做快照文件名）；留空则首次推送时自动生成
	#（主机名 + MAC 后 4 位，例如 iStoreOS-a1b2）并写回本文件
	option node_id ''
	# 展示名；留空则用 node_id
	option node_name ''
	# 子节点：母节点地址，例如 http://192.168.100.1；留空 = 不推送
	option mother_url ''
	# 子母共享密钥（母节点校验 HMAC 用），两边必须一致；留空则拒绝推送/接收
	option mother_secret ''
	# 1 = 允许向母节点推送；0 = 关闭（默认）
	option mother_enabled '0'
	# ── 哑桥 AP 无线站点元数据（只报信号/速率，绝不报字节）─────────────
	# 为什么只报元数据：AP 是二层桥，客户端流量全部经主路由转发并已被主路由统计；
	# AP 若也报字节就是重复计数（docs/AP-ROLE.md 方案 B）。
	# 1 = 允许 AP 侧上报无线元数据；0 = 关闭（默认）
	option stations_enabled '0'
	# 母/子共享令牌（母节点的 stations_token 必须一致，否则拒收）。
	# 注意：这是**仅限局域网、非签名**通道（AP 上没有 openssl，无法做 HMAC），
	# 不要把 web 端口暴露到 WAN。生成：hexdump -n 16 -e '16/1 "%02x"' /dev/urandom
	option stations_token ''
	# 逗号分隔的 AP 接口名，例如 phy0.0-ap1,phy0.1-ap0；留空 = 自动枚举 iw dev 里的 phy*-ap*
	option station_ifaces ''

config feishu 'feishu'
	# 总开关：设 0 可临时静音（未配置 webhook/app 时无论如何都不会发送）
	option enabled '1'
	option webhook ''
	option app_id ''
	option app_secret ''
	option chat_id ''
	option card_wrapper 'card'
	option secret ''
	# 每日推送时间 HH:MM（本地时间）
	option daily_time '08:30'
	option report_chat_enabled '1'
	# 以下为告警相关开关（由飞书模块使用；守护进程只透传不消费）
	option alert_enabled '1'
	option alert_new_device '1'
	option device_daily_limit ''
	option alert_cooldown '1800'
	# ── 发什么（逗号分隔，按配置顺序渲染）─────────────────────────────
	# 可选：overview（总量/在线设备/速率 + 近 24h 折线图）、proxy_direct（代理 vs 直连）、
	#       wifi_wired（无线 vs 有线）、system（软路由 CPU/内存/负载/磁盘/温度/运行时长，
	#       数据来自 state.json 的 system 段，缺失时该区块自动跳过）、
	#       top_devices、top_apps、nodes（多节点列表）
	# 关掉全部推送：写 'none'（注意 UCI 里 option 写空串等同「未设置」，会回落到本默认值）。
	# 整项缺省 = 用本默认值（老配置行为不变）；写进无效名字 = 该名字被忽略。
	option report_items 'overview,proxy_direct,wifi_wired,top_devices,top_apps'
	# ── 什么时候发（cron 交给用户；用 `feishu.uc scheduled` 才会按这里判定）──────
	# daily = 每天；weekly = report_weekday 那天；both = 每天（那天算周报标题）
	option report_mode 'daily'
	# HH:MM（本地时间）；留空则回落到上面的 daily_time
	option report_time '08:30'
	# 1=周一 … 7=周日，仅 weekly / both 使用
	option report_weekday '1'
	# ── 什么情况下发（全部留空 = 不启用对应告警，行为与旧版一致）──────────────
	# 单个域名/应用日流量阈值，如 20G
	option alert_app_daily_limit ''
	# 突增倍数，如 3 = 当前小时 > 近 7 日均值（每小时）×3
	option alert_spike_ratio ''
	# 设备离线超过 N 分钟告警
	option alert_offline_min ''
	# 软路由 CPU / 内存 / 磁盘使用率告警阈值（依赖 state.json 的 system 段）
	option alert_cpu_pct ''
	option alert_mem_pct ''
	option alert_disk_pct ''
	# 免打扰时段，如 23:00-07:00（可逗号分隔多段）；只抑制告警，报表不受影响
	option alert_quiet_hours ''

# ── 数据 / 日志保留与清理（/usr/share/traffic-stats/retention.uc）─────────────
# 清理范围是**硬编码白名单**（下面注释里那几个目录），本段只改天数/大小，没有路径项，
# 所以不可能被配置改去删系统目录。具体行为见 docs/SPEC.md §9。
# 定时触发由用户自己加 cron（脚本不改 crontab）：
#   30 3 * * * /usr/bin/ucode /usr/share/traffic-stats/retention.uc >/dev/null 2>&1
# 手动跑一次看清单：ucode /usr/share/traffic-stats/retention.uc --dry-run
#
# 注意：本段存在且 enabled=1 时，daily 的清理由 retention.uc 按 daily_days 负责，
# 守护进程不再按 settings.history_days 做「只留 N 个文件」的计数裁剪；删掉整段
# 则回到旧行为（老配置升级后完全不受影响）。
config retention 'retention'
	# 总开关：0 = 什么都不删、不截断（回到旧行为）
	option enabled '1'
	# /etc/traffic-stats/daily/*.json：按文件名里的日期保留（一天一个文件）
	option daily_days '400'
	# /etc/traffic-stats/nodes/*.json / *.jsonl：按文件名日期，没有日期就按 mtime
	option nodes_days '30'
	# /etc/traffic-stats/stations/*.json：同上
	option stations_days '7'
	# /tmp/traffic-stats/*.log：按 mtime 保留天数
	option log_days '7'
	# 单个日志超过这个大小就截断，只保留尾部一半（KB）
	option log_max_kb '512'
	# /tmp/traffic-stats/feishu-queue 总量上限（KB），超了从最旧的开始删
	option spool_max_kb '2048'
	# 1 = 只打印将要删除/截断的清单，不实际动文件（首次启用建议先 1 跑一次看输出）
	option dry_run '0'
